# ============================================================================
# ML DEPLOYMENT PLATFORM — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit your real .env file — it is already in .gitignore.
# ============================================================================


# ============================================================================
# AWS CONFIGURATION
# ============================================================================

# ✅ NO ACCESS KEYS REQUIRED
# -----------------------------------------------------------------------
# Production (ECS Fargate):
#   Credentials are injected automatically via the IAM Task Role attached
#   to the ECS Task Definition. boto3 uses the container metadata endpoint
#   (169.254.170.2) to get short-lived, auto-rotating credentials.
#   No key files, no rotation scripts, no secrets to leak.
#
# Local development:
#   Run `aws configure` once on your machine (stored in ~/.aws/credentials).
#   boto3 picks this up automatically — no env vars needed in .env.
# -----------------------------------------------------------------------

# AWS Region where EC2 instances will be created
# Examples: us-east-1, us-west-2, eu-west-1, ap-south-1
AWS_REGION=us-east-1

# EC2 Key Pair Name (must exist in your AWS region)
# Create at: EC2 Console → Key Pairs → Create Key Pair
AWS_KEY_PAIR_NAME=your-key-pair-name


# ============================================================================
# EC2 INSTANCE CONFIGURATION
# ============================================================================

# AMI ID for Ubuntu 20.04 LTS (varies by region — update for your region)
# Find your region's AMI: https://cloud-images.ubuntu.com/locator/ec2/
# us-east-1:  ami-0c55b159cbfafe1f0
# us-west-2:  ami-0d1cd67c26f5fca19
# ap-south-1: ami-019715e0d74f695be
EC2_AMI_ID=ami-0c55b159cbfafe1f0

# Instance type (t2.micro / t3.micro are AWS Free Tier eligible)
EC2_INSTANCE_TYPE=t3.micro

# Root volume size in GB (minimum: 8, recommended: 20)
EC2_VOLUME_SIZE=20

# Optional: VPC ID to launch the EC2 instance and Security Group into
# ECS only — must match the VPC where the platform itself is deployed.
# Leave blank for local dev (default VPC is used).
EC2_VPC_ID=

# Optional: public subnet ID inside the above VPC for EC2 instance placement
# ECS only — must be a public subnet in the same VPC as the platform.
# Leave blank for local dev (default VPC is used).
EC2_SUBNET_ID=


# ============================================================================
# SECURITY GROUP CONFIGURATION
# ============================================================================

# Security Group name (created automatically if it doesn't exist)
SECURITY_GROUP_NAME=ml-deployment-sg

# Allowed SSH IP range (CIDR notation)
# 0.0.0.0/0   = Allow from anywhere (NOT recommended for production)
# x.x.x.x/32 = Allow only from your IP (get it: curl ifconfig.me)
ALLOWED_SSH_IP=0.0.0.0/0


# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Port for the Flask backend server
APP_PORT=5000

# Flask environment (development | production)
FLASK_ENV=development

# Secret key for Flask sessions
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  Use a strong random value — never use this placeholder in production
SECRET_KEY=your_secret_key_here

# JWT secret key for signing auth tokens (must differ from SECRET_KEY)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  Use a strong random value — never use this placeholder in production
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT token expiry in hours (default: 1)
JWT_EXPIRY_HOURS=1

# Local path to frontend static build folder (used by Flask in production)
STATIC_FOLDER=../frontend/dist


# ============================================================================
# FIRST-ADMIN BOOTSTRAP
# ============================================================================
# On startup the app auto-creates this admin if no admin exists yet.
# The password is hashed with bcrypt (rounds=12) and the plaintext is wiped
# from memory immediately. Bootstrap is idempotent — ignored if admin exists.
#
# Local dev:   set values here and restart the backend.
# Production:  store as a JSON secret in AWS Secrets Manager:
#              { "ADMIN_EMAIL": "...", "ADMIN_PASSWORD": "..." }
#              and inject via ECS Task Definition secret → env var.
#
# ⚠️  Change ADMIN_PASSWORD before first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!


# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# DOCKER_CONTAINER_PORT: port your ML app listens on INSIDE the container
#   Must match: EXPOSE <port> in the app's Dockerfile
#               app.run(port=<port>) in the app's code
#
# DOCKER_HOST_PORT: port exposed on the EC2 host machine
#   NGINX proxies port 80 → this port on the host
#   Typically the same as DOCKER_CONTAINER_PORT
#
# Users always reach the app via http://your-ec2-ip/ (port 80, via NGINX)

# Port your ML app listens on inside its Docker container
DOCKER_CONTAINER_PORT=8000

# Port exposed on the EC2 host (what NGINX proxies to)
DOCKER_HOST_PORT=8000


# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# Maximum time to wait for a deployment to complete (seconds)
MAX_DEPLOYMENT_TIME=600

# Time between health-check polling attempts (seconds)
HEALTH_CHECK_INTERVAL=10

# Number of health-check retries before marking a deployment failed
HEALTH_CHECK_RETRIES=5

# Maximum time to wait for the EC2 instance to be ready (seconds)
EC2_READY_TIMEOUT=300

# Time between EC2 readiness polling attempts (seconds)
EC2_READY_POLL_INTERVAL=10

# Maximum time to wait for SSH connectivity to the instance (seconds)
SSH_READY_TIMEOUT=420

# Time between SSH connectivity polling attempts (seconds)
SSH_RETRY_INTERVAL=5


# ============================================================================
# GITHUB CONFIGURATION
# ============================================================================

# GitHub Personal Access Token (optional — only required for private repos)
# Generate at: https://github.com/settings/tokens   Required scopes: repo
GITHUB_TOKEN=your_github_token_here


# ============================================================================
# CORS / FRONTEND CONFIGURATION
# ============================================================================

# Comma-separated list of allowed CORS origins (no trailing slash)
# Local dev:   http://localhost:80,http://localhost
# Production:  https://your-domain.com
CORS_ORIGINS=http://localhost:80,http://localhost

# Public URL of the frontend (used for redirects and link generation)
FRONTEND_URL=http://localhost


# ============================================================================
# NGINX CONFIGURATION
# ============================================================================

# Enable NGINX reverse proxy (recommended for production)
# true  = users access via port 80 — no port number in the URL
# false = users access directly via DOCKER_HOST_PORT
ENABLE_NGINX=true

# HTTP port for NGINX
NGINX_HTTP_PORT=80

# HTTPS port for NGINX (requires an SSL certificate)
NGINX_HTTPS_PORT=443

# Enable SSL/HTTPS via Let's Encrypt (requires a domain name)
ENABLE_SSL=false

# Email for Let's Encrypt SSL certificate registration
SSL_EMAIL=your-email@example.com


# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log file name (written to the backend/ directory)
LOG_FILE=deployment.log


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# ── PostgreSQL service credentials ─────────────────────────────────────────
# Used by the docker-compose `postgres` service and Alembic migrations.
POSTGRES_USER=dbadmin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=autodeploy

# Full SQLAlchemy connection string.
# Docker (backend container → postgres container on the same network):
DATABASE_URL=postgresql://dbadmin:your_db_password_here@localhost:5432/autodeploy

# Uncomment to use local SQLite instead of PostgreSQL (dev only):
# DATABASE_URL=sqlite:///./deployment_platform.db


# ============================================================================
# PEM / SSH KEY CONFIGURATION
# ============================================================================
# AWS Secrets Manager secret name that holds the private key.
# Leave blank to skip fetch (Option A — manual volume mount for local dev).
PEM_SECRET_NAME=your-secrets-manager-secret-name

# Filesystem path where the key is stored or written inside the container.
# This is the single source of truth — used by both the PEM loader and SSHClient.
# Docker/ECS: /app/ml-deploy-key.pem
# Local Python dev (Windows): backend/ml-deploy-key.pem
PEM_KEY_PATH=/app/ml-deploy-key.pem