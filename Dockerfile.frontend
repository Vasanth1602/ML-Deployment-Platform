# ============================================================
# Frontend Dockerfile — Multi-stage build
# ============================================================
# Stage 1: Build the React/Vite app (Node.js)
# Stage 2: Serve with Nginx (lightweight, no Node.js in final image)
#
# Build (always from the PROJECT ROOT, not from frontend/):
#   docker build -f Dockerfile.frontend -t autodeploy-frontend .
#
# Run standalone — BACKEND_HOST must point to your backend container/host:
#   docker run --rm \
#     -e BACKEND_HOST=<backend-ip-or-hostname> \
#     -e BACKEND_PORT=5000 \
#     -p 80:80 \
#     autodeploy-frontend
#
#   Docker Compose:       BACKEND_HOST=backend        (docker network service name)
#   ECS sidecar:          BACKEND_HOST=localhost       (shared network namespace)
#   ECS separate tasks:   BACKEND_HOST=<Cloud Map DNS name>
#   Standalone docker run: BACKEND_HOST=<actual IP or hostname of the backend container>
#
# ⚠️  The default ENV BACKEND_HOST=backend only resolves inside Docker Compose.
#    Always override it when running outside of Compose.
# ============================================================

# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first (layer cache optimization)
COPY frontend/package.json frontend/package-lock.json ./

# Install all dependencies
RUN npm ci

# Copy all frontend source code
COPY frontend/ .

# Build the production bundle → /app/dist/
# VITE_API_URL is empty here — browser calls go through nginx proxy
# nginx proxies /api/* and /socket.io/* to the backend container
RUN npm run build


# ── Stage 2: Serve with Nginx ───────────────────────────────
FROM nginx:alpine

# Install gettext for envsubst (substitutes env vars into nginx template)
RUN apk add --no-cache gettext

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our nginx config template (uses ${BACKEND_HOST} and ${BACKEND_PORT})
COPY nginx/frontend.conf.template /etc/nginx/templates/frontend.conf.template

# Copy built React app from Stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Default env vars — override in ECS Task Definition:
#   Docker Compose / local:   BACKEND_HOST=backend   BACKEND_PORT=5000
#   ECS same-task (sidecar):  BACKEND_HOST=localhost  BACKEND_PORT=5000
#   ECS separate tasks:        BACKEND_HOST=<Cloud Map DNS>  BACKEND_PORT=5000
ENV BACKEND_HOST=backend
ENV BACKEND_PORT=5000

# At startup: substitute env vars into the template → write final nginx config, then start nginx
CMD ["/bin/sh", "-c", "envsubst '${BACKEND_HOST} ${BACKEND_PORT}' < /etc/nginx/templates/frontend.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
