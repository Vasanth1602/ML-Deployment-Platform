# ============================================================
# Frontend Dockerfile — Multi-stage build
# ============================================================
# Stage 1: Build the React/Vite app (Node.js)
# Stage 2: Serve with Nginx (lightweight, no Node.js in final image)
# ============================================================

# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20.19-alpine AS builder

WORKDIR /app

# Copy package files first (layer cache optimization)
COPY frontend/package.json frontend/package-lock.json ./

# Install all dependencies
RUN npm ci

# Copy all frontend source code
COPY frontend/ .

# Build the production bundle → /app/dist/
# VITE_API_URL is empty here — browser calls go through nginx proxy
# nginx proxies /api/* and /socket.io/* to the backend container
RUN npm run build


# ── Stage 2: Serve with Nginx ───────────────────────────────
FROM nginx:1.27-alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx config
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy built React app from Stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# # ----------------------------------------------------------------
# # FIX: Create nginx runtime directories and give nginx user access
# # ----------------------------------------------------------------
# RUN mkdir -p /var/cache/nginx \
#     && mkdir -p /var/run \
#     && mkdir -p /var/log/nginx \
#     && chown -R nginx:nginx /var/cache/nginx \
#     && chown -R nginx:nginx /var/run \
#     && chown -R nginx:nginx /var/log/nginx \
#     && chown -R nginx:nginx /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -q --spider http://localhost || exit 1

# # Run nginx as non-root user
# USER nginx

# Nginx starts automatically
CMD ["nginx", "-g", "daemon off;"]
