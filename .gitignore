# ============================================================
# ML Deployment Platform - Production Safe .gitignore
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
wheels/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/
deployment_logs/
backend/deployment_logs/     # nested deployment log folder

# ------------------------------------------------------------
# Environment Variables
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Secrets & Keys (CRITICAL)
# ------------------------------------------------------------
*.pem
*.key
*.crt
backend/*.pem
aws_credentials.json

# ------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/

# Frontend environment files
frontend/.env.local
frontend/.env.production

# Keep lock file (DO NOT IGNORE)
# frontend/package-lock.json   <-- intentionally NOT ignored

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
docker-compose.override.yml
*.tar
*.gz

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------
# OS
# ------------------------------------------------------------
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Terraform
# ------------------------------------------------------------

# Provider binaries — huge (~200MB), never commit
**/.terraform/

# State files — contain secrets (DB passwords, ARNs, IPs)
**/*.tfstate
**/*.tfstate.backup

# Plan output — can contain secrets in plain text
*.tfplan
**/*.tfplan

# Crash logs
crash.log
crash.*.log

# Local override files — machine-specific, never shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config — personal credentials/settings
.terraformrc
terraform.rc

# Terraform docs
/infrastructure/docs/*.md

# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
#       Commit it — locks provider versions for all teammates + CI.

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------

tmp/
temp/
*.resolved                   # generated task resolution artefacts (e.g. task.md.resolved)
Issues faced.txt
ECS_ENV_REFERENCE.md
ecs_fargate_setup_flow.html
# ------------------------------------------------------------
# Tests
# ------------------------------------------------------------
tests/
Makefile
.coveragerc
pytest.ini