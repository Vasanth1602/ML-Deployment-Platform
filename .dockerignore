# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/
env/

#keys
backend/*.pem

# SQLite dev database (PostgreSQL is used in containers)
backend/deployment_platform.db
deployment_platform.db

# Logs
backend/deployment.log
backend/deployment_logs/
*.log

# Node / Frontend
frontend/node_modules/
frontend/dist/

# Git
.git/

# Tests
tests/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets — NEVER bake into Docker images.
# .env is excluded from build context; all secrets are injected at runtime
# via ECS Task Definition env vars / Secrets Manager, or docker-compose env: block.
.env
.env.*
!.env.example

# Frontend local dev env files — MUST be excluded or Vite bakes localhost URLs into the bundle.
# .env.* above only matches root-level files; these patterns cover the frontend/ subdirectory.
frontend/.env.local
frontend/.env.*.local
frontend/.env.*
