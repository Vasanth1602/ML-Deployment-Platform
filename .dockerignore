# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/
env/

# SQLite dev database (PostgreSQL is used in containers)
backend/deployment_platform.db
deployment_platform.db

# Logs
backend/deployment.log
backend/deployment_logs/
*.log

# Node / Frontend
frontend/node_modules/
frontend/dist/

# Git
.git/
.gitignore

# Tests
tests/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets — injected at runtime via ECS Task Definition or AWS Secrets Manager.
# NEVER copy .env into the image. It is excluded here as defence-in-depth.
.env
.env.*
